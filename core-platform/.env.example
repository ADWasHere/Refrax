# Copy to .env and adjust as needed — `docker compose` reads it from this directory
# automatically. Every variable already has a working default below; you only need a .env
# file at all if you want to change one. Mirrors core-platform/src/main/resources/application.properties.

# --- HTTP ---
HTTP_PORT=8787

# --- Database (the `db` service below) ---
# DB_HOST_PORT is the *host*-side port Postgres is reachable on, e.g. for `psql` from outside
# Docker. DB_HOST/DB_PORT are what the `core` service connects to inside the Docker network.
DB_HOST_PORT=5432
DB_HOST=db
DB_PORT=5432
DB_NAME=refrax
DB_USER=postgres
DB_PASSWORD=postgres

# --- Event schemas and views to load, comma-separated (see core-platform/configs) ---
REFRAX_SCHEMA_LOCATIONS=/configs/schemas/air-quality-reading.json
REFRAX_VIEW_LOCATIONS=/configs/views/air-quality-full.json,/configs/views/air-quality-value-only.json

# --- Tenant resolution ---
# "header" reads X-Tenant-ID; "token-claim" reads a claim from a verified OIDC token instead.
REFRAX_TENANT_RESOLVER=header
# Dot-separated path into the token's verified claims. Only used when
# REFRAX_TENANT_RESOLVER=token-claim.
REFRAX_TENANT_CLAIM_PATH=org_id

# Comma-separated tenant identities allowed to provision new tenants via POST /v1/tenants.
# Not real auth — just gates a privileged endpoint against whoever can set X-Tenant-ID.
REFRAX_TENANT_ADMIN_IDS=admin
